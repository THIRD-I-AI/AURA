# AURA free-tier deploy — copy to .env on the instance and fill in.
#   cp .env.example .env
#
# NEVER commit the filled-in .env. Only this .example file belongs in git.
#
# Every AURA_* value below is REQUIRED: shared/config.py validates them at
# startup and refuses to boot if any is missing or wrong. That is deliberate —
# a misconfigured production deploy should fail loudly at boot rather than
# quietly serve every tenant from one shared workspace. Do not "fix" a boot
# failure by relaxing a value here; read the error, it names the exact guard.

# ── Image source ────────────────────────────────────────────────────────────
# Owner segment of the GHCR path, lowercased — GHCR rejects uppercase.
# cd.yml sets IMAGE_NAME from ${{ github.repository }}, so for THIRD-I-AI/AURA
# the published path is ghcr.io/third-i-ai/aura.
GHCR_OWNER=third-i-ai

# Release version WITHOUT the leading "v". cd.yml uses
# `type=semver,pattern={{version}}`, so git tag v0.1.0 publishes tag `0.1.0`,
# and compose appends the tier suffix: 0.1.0-base and 0.1.0-frontend.
# `latest` is only published on pushes to main, never on tags — so leaving
# this as `latest` while deploying from a tag pulls an image that isn't there.
AURA_TAG=0.1.0

# ── GHCR pull credentials ───────────────────────────────────────────────────
# The images are PRIVATE, and deliberately so: the backend image contains the
# full application source, so making the package public would publish the
# codebase to anyone who runs `docker pull`. Verified private — an anonymous
# manifest request returns HTTP 403.
#
# So the instance authenticates with a read-only token. Create one at
#   https://github.com/settings/tokens/new?scopes=read:packages
# with ONLY the `read:packages` scope — it cannot push, and cannot read code.
GHCR_USER=your-github-username
GHCR_TOKEN=

# ── Public hostname ─────────────────────────────────────────────────────────
# Must already resolve to this instance's public IP. A free option is DuckDNS
# (https://duckdns.org) — e.g. yourname.duckdns.org. Let's Encrypt cannot
# issue a certificate for a bare IP address.
AURA_DOMAIN=yourname.duckdns.org

# ── Production guards (all fail closed — see STATUS.md) ─────────────────────
ENVIRONMENT=production
AURA_JWT_ENABLED=true
AURA_AUTH_MODE=password
AURA_AUDIT_ENABLED=true

# Must match AURA_DOMAIN exactly, and must be https://. An http:// origin is
# rejected in production by design.
CORS_ALLOWED_ORIGINS=https://yourname.duckdns.org

# ── Secrets — generate these, do not invent them by hand ────────────────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AURA_CREDENTIAL_ENCRYPTION_KEY=

# ── LLM provider ────────────────────────────────────────────────────────────
# This is the one genuinely non-zero cost in the whole deploy. AWS is free;
# the model calls are not. Set whichever provider the agents are configured
# against.
ANTHROPIC_API_KEY=

# ── Caddy / Let's Encrypt ───────────────────────────────────────────────────
# Used only for expiry-notice email. Not published anywhere.
ACME_EMAIL=you@example.com
